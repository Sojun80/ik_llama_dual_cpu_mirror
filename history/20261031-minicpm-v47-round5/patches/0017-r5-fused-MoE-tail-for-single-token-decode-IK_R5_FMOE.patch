         const struct ggml_cgraph * cgraph, int i) {
 
@@ -27927,7 +28087,15 @@ static int ggml_compute_forward(struct ggml_compute_params * params, struct ggml
             } break;
         case GGML_OP_MUL_MAT_ID:
             {
-                ggml_compute_forward_mul_mat_id(params, tensor);
+                if (r5_fmoe_mode() > 0 && r5_fmoe_match(cgraph, i, params->wsize)) {
+                    i = r5_fmoe(params, cgraph, i);
+                } else {
+                    if (r5_fmoe_mode() == 3 && params->ith == 0 && tensor->src[2]->ne[1] == 1) {
+                        static int r5f_m = 0;
+                        if (r5f_m++ < 100) fprintf(stderr, "r5_fmoe: no match at node %d %s (check line %d)\n", i, tensor->name, r5f_line);
+                    }
+                    ggml_compute_forward_mul_mat_id(params, tensor);
+                }
             } break;
         case GGML_OP_MOE_FUSED_UP_GATE:
             {
diff --git a/ggml/src/iqk/iqk_cpu_ops.cpp b/ggml/src/iqk/iqk_cpu_ops.cpp
index bf48d1e3..651e3ca9 100644
--- a/ggml/src/iqk/iqk_cpu_ops.cpp
+++ b/ggml/src/iqk/iqk_cpu_ops.cpp
