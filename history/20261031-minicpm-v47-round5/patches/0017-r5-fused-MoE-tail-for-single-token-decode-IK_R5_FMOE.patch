+extern "C" IQK_API bool iqk_r5_rows(long Nx, long ne00, int typeA, const void * A, long strideA,
+        int typeB, const void * B, long strideB, float * C) {
+    MulMat mm;
+    if (!MulMat::prepare(typeA, typeB, ne00, mm, 1)) return false;
