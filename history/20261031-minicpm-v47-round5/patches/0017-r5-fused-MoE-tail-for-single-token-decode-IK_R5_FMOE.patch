 ggml/src/iqk/iqk_cpu_ops.cpp |  18 ++++
 ggml/src/iqk/iqk_cpu_ops.h   |   4 +
 ggml/src/iqk/iqk_mul_mat.cpp |  14 +++
 ggml/src/iqk/iqk_mul_mat.h   |   4 +
