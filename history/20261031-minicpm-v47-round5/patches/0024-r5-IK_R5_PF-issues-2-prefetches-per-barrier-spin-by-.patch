From c3d52ea4b20a9849f63eda22af40d7998a5e5ed9 Mon Sep 17 00:00:00 2001
From: r5 <r5@local>
Date: Sun, 1 Nov 2026 21:15:26 -0800
Subject: [PATCH 24/25] r5: IK_R5_PF issues 2 prefetches per barrier spin by
 default (was 4)

A waiting thread issues IK_R5_PF_LINES prefetches before each check of
the barrier; with 4 the mostly-sync small nodes were ~0.6 ms per token
slower than without prefetch (runs/81). 2 lines: +3.3% at 2.8K, +1.0% at
9.4K (runs/83). Not prefetching in the cross-node leader's wait was
worse (runs/82, runs/83). Bit-exact (runs/84).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml.c b/ggml/src/ggml.c
index 78b23ff8..94859025 100644
--- a/ggml/src/ggml.c
+++ b/ggml/src/ggml.c
@@ -4984,12 +4984,12 @@ static GGML_THREAD_LOCAL struct r5pf_range r5pf_q[R5PF_MAXR];
 static GGML_THREAD_LOCAL int r5pf_h, r5pf_t;            // queue [head, tail)
 static GGML_THREAD_LOCAL int r5pf_next = -1, r5pf_last = -1;
 static GGML_THREAD_LOCAL const void * r5pf_g;
-static int    r5pf_mode = -1, r5pf_lines = 4, r5pf_win = 32, r5pf_fa = 0;
+static int    r5pf_mode = -1, r5pf_lines = 2, r5pf_win = 32, r5pf_fa = 0;
 static size_t r5pf_budget = 256*1024;
 
 static void r5pf_init(void) {
     const char * e;
-    int lines = 4, win = 32;
+    int lines = 2, win = 32;
     size_t budget = 256*1024;
     if ((e = getenv("IK_R5_PF_LINES")))  lines  = atoi(e) > 0 ? atoi(e) : 1;
     if ((e = getenv("IK_R5_PF_WIN")))    win    = atoi(e) > 0 ? atoi(e) : 1;
-- 
